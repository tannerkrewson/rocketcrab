# Build-time configuration for the Nova main origin; no secrets here.
# Copy to .env locally or set via the deployment scripts
# (deploy/README.md).

# Runtime origin for production builds. Baked into the runtime iframe URL
# AND the strict CSP frame-src, so it must be the exact runtime origin.
# Production deploys pin the runtime site origin; local dev swaps to port 2723.
# VITE_RUNTIME_ORIGIN=https://runtime.nova.example

# Nova edge Worker origin (deploy/edge): external-game room-creation relay at "/"
# TURN mint at "/turn", and party signaling at "/signal". Allowlisted in CSP.
# Unset disables these services. The deploy script pins this to production.
# VITE_EDGE_ORIGIN=https://rocketcrab-edge.tannerkrewson.workers.dev

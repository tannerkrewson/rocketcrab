# Build-time configuration for the Nova main origin (M2 deployment).
# Copy to .env for local experimentation, or set these in the deploy
# workflow inputs (docs/architecture/deployment.md) — no secrets here.

# Runtime origin for production builds. Baked into the runtime iframe URL
# AND the strict CSP frame-src, so it must be the exact runtime origin.
#   strategy (a) custom-domain subdomains: https://runtime.<your-domain>
#   strategies (b)/(c) other accounts/hosts: the runtime site's origin
# Leave unset in local dev: the origin is derived (dev: port swap to 5174;
# production: `runtime.` hostname prefix).
# VITE_RUNTIME_ORIGIN=https://runtime.nova.example

# Base path of the runtime site when it is a project site (two-account /
# alternate-host strategy), e.g. /runtime/. "/" for custom domains.
# VITE_RUNTIME_BASE=/

# Optional classic-game CORS relay origin (deploy/relay). Allowlisted in the
# strict CSP connect-src; leave unset to use direct fetches only.
# VITE_CLASSIC_RELAY_ORIGIN=https://rocketcrab-cors-relay.<account>.workers.dev

# Optional TURN credential mint origin (deploy/turn-creds). Allowlisted in the
# strict CSP connect-src. Empty disables TURN entirely (parties work exactly
# as before, without cross-network relay). One 24 h credential is minted per
# party at join time; the app does not refresh it mid-party.
# VITE_TURN_CREDS_ORIGIN=https://rocketcrab-turn-creds.<account>.workers.dev

# Optional comma-separated Nostr relay URLs for party discovery. Only set an
# owner-approved, re-probed set (docs/testing/trystero-connectivity-findings.md).
# Invalid entries are ignored. Empty uses Trystero-maintained relay defaults.
# VITE_TRYSTERO_RELAYS=wss://nos.lol,wss://relay.primal.net

{
    "name": "rocketcrab",
    "author": "Tanner Krewson",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "cross-env NODE_ENV=development nodemon",
        "build": "vite build",
        "start": "cross-env NODE_ENV=production node --experimental-strip-types server/with-tanstack.ts",
        "type-check": "tsc --pretty --noEmit",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:staged": "lint-staged",
        "test": "NODE_OPTIONS='--experimental-strip-types --experimental-require-module' vitest run",
        "test:watch": "NODE_OPTIONS='--experimental-strip-types --experimental-require-module' vitest",
        "test:all": "run-s lint type-check test",
        "test:coverage": "NODE_OPTIONS='--experimental-strip-types --experimental-require-module' vitest run --coverage",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.@(js|ts|tsx|json)": [
            "oxlint --fix"
        ]
    },
    "dependencies": {
        "@aw-web-design/react-textfit": "4.1.135",
        "@fontsource/inconsolata": "^5.3.0",
        "@fontsource/mukta": "^5.3.0",
        "@nextui-org/react": "^2.4.6",
        "@rsbuild/core": "2.1.9",
        "@tanstack/react-router": "1.170.18",
        "@tanstack/react-start": "1.168.33",
        "bad-words": "^3.0.4",
        "classnames": "^2.5.1",
        "cross-env": "^7.0.3",
        "date-fns": "^3.6.0",
        "dexie": "^4.4.4",
        "emoji-picker-react": "^4.19.1",
        "express": "^5.2.1",
        "fslightbox-react": "^1.7.6",
        "next": "^14.2.5",
        "next-dark-mode": "^3.0.0",
        "next-pwa": "^5.6.0",
        "nookies": "^2.5.2",
        "phonetic-alphabet-converter": "^1.1.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-ga4": "^2.1.0",
        "react-ios-pwa-prompt": "^2.0.6",
        "react-markdown": "^6.0.3",
        "react-qr-code": "^2.2.0",
        "react-spinners-kit": "^1.9.1",
        "react-toastify": "^10.0.5",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "swiper": "^11.2.10",
        "uuid": "^10.0.0",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "@testing-library/react": "^16.0.0",
        "@types/node": "^22.20.1",
        "@types/react": "^18.3.3",
        "@types/supertest": "^7.2.1",
        "@types/webpack-env": "^1.18.8",
        "@types/ws": "^8.5.11",
        "autoprefixer": "^10.4.19",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^15.5.2",
        "nodemon": "^3.1.14",
        "npm-run-all": "^4.1.5",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "postcss": "^8.4.40",
        "supertest": "^7.2.2",
        "tailwindcss": "^3.4.7",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tannerkrewson/rocketcrab.git"
    },
    "bugs": {
        "url": "https://github.com/tannerkrewson/rocketcrab/issues"
    },
    "homepage": "https://rocketcrab.com/",
    "engines": {
        "node": "24.x",
        "npm": "10.x"
    }
}

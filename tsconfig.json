{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true
    },
    "exclude": [
        "node_modules",
        ".next",
        "out",
        "test",
        "app",
        "app.config.ts",
        "vite.config.ts"
    ],
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.js"]
}

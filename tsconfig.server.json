{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "outDir": "dist",
        "target": "es2022",
        "isolatedModules": false,
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "declaration": false
    },
    "include": ["server/**/*.ts"]
}
